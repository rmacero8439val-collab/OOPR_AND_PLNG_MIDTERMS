package com.mycompany.mavenproject2;

import java.util.Scanner;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.time.temporal.ChronoUnit;

public class NewClass {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        DateTimeFormatter formatter = DateTimeFormatter.ofPattern("d/M/yyyy");

        String name = "";
        while (name.isEmpty()) {
            System.out.print("Enter your name: ");
            String input = scanner.nextLine().trim();
            
            if (input.matches("^[a-zA-Z\\s]+$")) {
                name = input;
            } else {
                System.out.println("Invalid input! Name must contain letters only (no numbers or special characters).");
            }
        }

        int totalPages = -1;
        while (totalPages <= 0) {
            System.out.print("How many pages does the book have?: ");
            if (scanner.hasNextInt()) {
                totalPages = scanner.nextInt();
                if (totalPages <= 0) {
                    System.out.println("Invalid input! Total pages must be greater than 0.");
                }
            } else {
                System.out.println("Invalid input! Please enter a valid whole number (no words or letters).");
                scanner.next();
            }
        }

        int pagesRead = -1;
        while (pagesRead < 0 || pagesRead > totalPages) {
            System.out.print("How many pages have you read?: ");
            if (scanner.hasNextInt()) {
                pagesRead = scanner.nextInt();
                if (pagesRead < 0) {
                    System.out.println("Invalid input! Pages read cannot be negative.");
                } else if (pagesRead > totalPages) {
                    System.out.println("Invalid input! Pages read cannot exceed total pages (" + totalPages + ").");
                }
            } else {
                System.out.println("Invalid input! Please enter a valid whole number (no words or letters).");
                scanner.next();
            }
        }
        scanner.nextLine();

        LocalDate issueDate = null;
        LocalDate dueDate = null;
        boolean validDates = false;

        do {
            System.out.print("Enter Issue Date (dd/mm/yyyy): ");
            String issueInput = scanner.nextLine().trim();

            System.out.print("Enter Due Date (dd/mm/yyyy): ");
            String dueInput = scanner.nextLine().trim();

            try {
                issueDate = LocalDate.parse(issueInput, formatter);
                dueDate = LocalDate.parse(dueInput, formatter);

                if (issueDate.isAfter(dueDate)) {
                    System.out.println("Invalid dates! Issue date cannot be after the due date. Please try again.\n");
                } else {
                    validDates = true;
                }
            } catch (Exception e) {
                System.out.println("Error parsing dates. Please use numbers in the dd/mm/yyyy format (e.g., 1/8/2026).\n");
            }
        } while (!validDates);

        boolean proceed = false;
        while (true) {
            System.out.print("\nAll data collected. Do you want to calculate your reading summary? (Y/N): ");
            String choice = scanner.nextLine().trim().toLowerCase();

            if (choice.equals("yes") || choice.equals("y")) {
                proceed = true;
                break;
            } else if (choice.equals("no") || choice.equals("n")) {
                proceed = false;
                break;
            } else {
                System.out.println("Invalid choice!");
            }
        }

        if (!proceed) {
            System.out.println("Calculation cancelled. Exiting system. Have a nice day!");
            scanner.close();
            return;
        }

        double percentageRead = ((double) pagesRead / totalPages) * 100;
        int pagesLeft = totalPages - pagesRead;

        LocalDate today = LocalDate.now(); 
        long daysRemaining = ChronoUnit.DAYS.between(today, dueDate);

        System.out.println("\nHello " + name + ", here is your reading summary:");
        System.out.println("You have read " + (int) percentageRead + "% of the book.");

        if (pagesLeft == 0) {
            System.out.println("Congratulations! You have already finished the book.");
        }

        if (daysRemaining < 0) {
            long daysOverdue = Math.abs(daysRemaining);
            System.out.println("Reminder: The return window for this book closed " + daysOverdue + " day(s) ago.");
            System.out.println("Please plan to return it to the library soon to prevent or settle any late fees.");
        } else if (daysRemaining == 0) {
            System.out.println("Notice: Today is the due date! Please arrange to return this book today.");
            if (pagesLeft > 0) {
                System.out.println("You still have " + pagesLeft + " pages left to finish.");
            }
        } else {
            int pagesPerDay = (int) Math.ceil((double) pagesLeft / daysRemaining);
            System.out.println("You have " + daysRemaining + " days remaining to return the book.");
            if (pagesLeft > 0) {
                System.out.println("To finish exactly on time, you should read " + pagesPerDay + " pages per day.");
            }
        }

        scanner.close();
    }
}
